# ===== PDK 本地开发配置示例：复制为 .env 后按需修改 =====
PDK_ENV=dev
# 开发模式鉴权（不接 PDS，拥有全部权限）；接入 PDS 时改为 pds
PDK_AUTH_MODE=dev
PDK_PUBLIC_URL=http://127.0.0.1:8000
# 前端开发服务器（pnpm dev）地址；随 pdk-api 发布时与 PUBLIC_URL 相同
PDK_WEB_URL=http://127.0.0.1:5175

# 存储：默认 SQLite + 本地目录 + 内存向量库，零依赖启动
PDK_DATABASE_URL=sqlite+aiosqlite:///./var/pdk.db
# PDK_DATABASE_URL=postgresql+asyncpg://pdk:pdk@127.0.0.1:5432/pdk
# PDK_REDIS_URL=redis://127.0.0.1:6379/0
# PDK_VECTOR_STORE=milvus
# PDK_MILVUS_URI=http://127.0.0.1:19530
# PDK_OBJECT_STORE=s3

# 模型：hash 为本地哈希向量（无语义，仅调试）；接入 bge-m3 时改为 openai
PDK_EMBED_PROVIDER=hash
PDK_EMBED_DIM=256
# PDK_EMBED_PROVIDER=openai
# PDK_EMBED_URL=http://127.0.0.1:9997/v1
# PDK_EMBED_MODEL=bge-m3
# PDK_EMBED_DIM=1024
# PDK_RERANK_PROVIDER=http
# PDK_MINERU_URL=http://127.0.0.1:8001

# PDS（PDK_AUTH_MODE=pds 时生效）
PDK_PDS_ISSUER=http://127.0.0.1:9000
PDK_PDS_CLIENT_ID=pdk-service
PDK_PDS_CLIENT_SECRET=pdk-service-dev-secret
PDK_CONSOLE_CLIENT_ID=pdk-console
PDK_CONSOLE_CLIENT_SECRET=pdk-console-dev-secret
# PDK_PDS_WEBHOOK_SECRET=
PDK_SYNC_MANIFEST_ON_STARTUP=true
